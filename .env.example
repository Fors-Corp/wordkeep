# Reference for the server's environment variables. Nothing loads this file
# automatically: set them in your shell, Docker/Fly secrets, or Vercel's
# Project → Settings → Environment Variables.

PORT=3001
HOST=0.0.0.0
# SQLite file for sync records, Claude limits and cache when self-hosted.
WORDKEEP_DB=./server/data/wordkeep.db
# Where word banks and the default database go (defaults to server/data, then /tmp).
# WORDKEEP_DATA_DIR=./server/data
CLIENT_DIST=./client/dist

# Optional: require this key before anyone can use the app or its API.
# WORDKEEP_ACCESS_KEY=change-me

# Optional: Claude grammar analysis for phrases (dictionary breakdown without it).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5
# WORDKEEP_DISABLE_AI=1

# Optional: Claude rate limits (per visitor and app-wide, per UTC day).
# WORDKEEP_AI_DAILY_PER_VISITOR=10
# WORDKEEP_AI_DAILY_TOTAL=100
# Salt for the hashed visitor ids.
# WORDKEEP_AI_SALT=some-random-text
# Behind your own reverse proxy (nginx, Caddy…), trust the last X-Forwarded-For
# hop for visitor ids. Vercel and Fly are recognized without it.
# TRUST_PROXY=1

# Optional: Upstash Redis for shared limits and cache (required for Claude on Vercel).
# KV_REST_API_URL=https://...upstash.io
# KV_REST_API_TOKEN=...
# (or UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)

# Optional: Turso database for sync between devices (required for sync on Vercel;
# self-hosted servers use WORDKEEP_DB without it).
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=...

# Extra origins allowed to call the API from a browser (comma separated).
# CORS_ORIGIN=https://your-app.fly.dev

# Skip downloading language lists and word banks at start (tests, quick restarts).
# WORDKEEP_SKIP_WARMUP=1
