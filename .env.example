PORT=3001
HOST=0.0.0.0
WORDKEEP_DB=./server/data/wordkeep.db
CLIENT_DIST=./client/dist
# Optional: require this key at / to protect a public deploy
# WORDKEEP_ACCESS_KEY=change-me
# Optional: Claude grammar analysis for phrases (dictionary breakdown without it)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: Claude rate limits (per hashed visitor IP and app-wide, per UTC day)
# WORDKEEP_AI_DAILY_PER_VISITOR=10
# WORDKEEP_AI_DAILY_TOTAL=100
# Optional: Upstash Redis for shared limits and cache (required for Claude on Vercel)
# KV_REST_API_URL=https://...upstash.io
# KV_REST_API_TOKEN=...
# Optional: seed the happy/feliz demo cluster
# WORDKEEP_SEED=1
# CORS_ORIGIN=https://your-app.fly.dev
WORDKEEP_SKIP_WARMUP=1
